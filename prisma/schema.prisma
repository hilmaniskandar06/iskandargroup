generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PageContent {
  id           Int      @id @default(1)
  homeTitle    String   @default("Untuk Indonesia yang lebih baik")
  homeDesc     String   @default("Our Businesses")
  homeSubDesc  String   @default("CT Corp is Indonesia's leading consumer-centric diversified group & ecosystem employing more than 100,000 people regionally.")
  homeHeroImg  String   @default("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop")
  whoWeAreText String   @default("Our Founder Prof. Dr. Chairul Tanjung grew CT Corp to be a massive business ecosystem.")
  whoWeAreImg  String   @default("https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=400&auto=format&fit=crop")
  privacyText  String   @default("Protecting the security and privacy of your personal data is important to CT Corp.")
  termsText    String   @default("This web site is provided by CT Corp and may be used for informational purposes only.")
  businessText String   @default("Our diversified business verticals.")
  investorText String   @default("Investor relations information.")
  updatedAt    DateTime @updatedAt
}

model BusinessCategory {
  id        Int            @id @default(autoincrement())
  title     String
  imageUrl  String?
  desc      String?
  content   String?
  linkUrl   String?
  order     Int            @default(0)
  items     BusinessItem[]
  createdAt DateTime       @default(now())
}

model BusinessItem {
  id          Int              @id @default(autoincrement())
  categoryId  Int
  category    BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  imageUrl    String
  linkUrl     String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
}

model Stat {
  id        Int      @id @default(autoincrement())
  value     String
  label     String
  order     Int      @default(0)
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String?
  imageUrl  String?
  published Boolean  @default(true)
  date      DateTime @default(now())
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CsrProgram {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String?
  imageUrl  String?
  category  String?
  date      DateTime @default(now())
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model InvestorContent {
  id        Int      @id @default(autoincrement())
  title     String
  type      String   @default("report")
  fileUrl   String?
  content   String?
  year      Int?
  quarter   Int?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
}
